# Runtime-only Dockerfile for CI pipeline
#
# Assumes target/*.jar has been built already and placed by the caller
# (CI matrix build job → uploaded as artifact → downloaded here).
#
# For local dev, use the multi-stage Dockerfile in this repo which
# does its own Maven build.

FROM eclipse-temurin:17-jre-jammy

WORKDIR /app

# Non-root user for defense in depth
RUN groupadd --system spring && useradd --system --gid spring spring
USER spring:spring

# Copy the pre-built JAR from build context
# --chown ensures the non-root user can read it
COPY --chown=spring:spring target/*.jar app.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
